; Unbounded scalar checks of the source-linked offer selection guards.
; Descriptor decoding and the complete Rust executor are outside this model.
(set-logic QF_LIA)
(declare-const outer Int)
(declare-const inner Int)
(declare-const outerPending Bool)
(declare-const innerPending Bool)
(define-fun priority () Int (ite outerPending outer (ite innerPending inner (- 1))))
(define-fun oldPriority () Int (ite innerPending inner (ite outerPending outer (- 1))))
(push)
(assert (and outerPending innerPending (distinct outer inner)))
(assert (distinct oldPriority outer))
(check-sat)
(pop)

; Actor-wide view residence cannot grant route control. Each head is one
; projected operation, not an inferred current-holder table.
(declare-const controller Int)
(declare-const view Int)
(declare-const leftRole Int)
(declare-const rightRole Int)
(declare-const leftPresent Bool)
(declare-const rightPresent Bool)
(declare-const leftOutbound Bool)
(declare-const rightOutbound Bool)
(declare-const residentController Bool)
(define-fun projectedController () Bool
  (or (and leftPresent leftOutbound (= leftRole controller))
      (and rightPresent rightOutbound (= rightRole controller))))
(define-fun viewController () Bool (and projectedController (= view controller)))
(push)
(assert residentController)
(assert (and leftPresent rightPresent (not leftOutbound) (not rightOutbound)))
(assert (distinct residentController projectedController))
(check-sat)
(pop)
(push)
(assert (and (not leftPresent) (not rightPresent)))
(assert projectedController)
(check-sat)
(pop)
(push)
(assert (and (not leftOutbound) (not rightOutbound)))
(assert projectedController)
(check-sat)
(pop)
(push)
(assert (and leftPresent leftOutbound (= leftRole controller)))
(assert (not projectedController))
(check-sat)
(pop)
(push)
(assert (distinct view controller))
(assert viewController)
(check-sat)
(pop)
(push)
(assert (not projectedController))
(assert viewController)
(check-sat)
(pop)
(push)
(assert outerPending)
(assert (distinct priority outer))
(check-sat)
(pop)
(push)
(assert (and (not outerPending) innerPending))
(assert (distinct priority inner))
(check-sat)
(pop)
(declare-const different Bool)
(declare-const atEntry Bool)
(declare-const member Bool)
(declare-const current Int)
(declare-const canonical Int)
(define-fun aligned () Int (ite (and different (not atEntry)) canonical current))
(push)
(assert (and different (not atEntry) member (distinct current canonical)))
(assert (distinct (ite (and different (not member)) canonical current) canonical))
(check-sat)
(pop)
(push)
(assert (and different (not atEntry)))
(assert (distinct aligned canonical))
(check-sat)
(pop)
(push)
(assert atEntry)
(assert (distinct aligned current))
(check-sat)
(pop)
(declare-const complete Bool)
(declare-const contains Bool)
(declare-const node Int)
(declare-const enclosing Int)
(define-fun envelope () Int (ite (and complete contains) enclosing node))
(push)
(assert (and complete contains))
(assert (distinct envelope enclosing))
(check-sat)
(pop)
(push)
(assert (not complete))
(assert (distinct envelope node))
(check-sat)
(pop)
(declare-const parentRight Bool)
(declare-const childRight Bool)
(declare-const parentAccepted Bool)
(declare-const childAccepted Bool)
(define-fun selectedLabel () Int (ite parentAccepted (ite parentRight (ite childAccepted (ite childRight 3 2) (- 1)) 1) (- 1)))
(push)
(assert (and parentAccepted childAccepted parentRight childRight))
(assert (distinct selectedLabel 3))
(check-sat)
(pop)
(push)
(assert (not parentAccepted))
(assert (distinct selectedLabel (- 1)))
(check-sat)
(pop)
(push)
(assert (and parentAccepted parentRight (not childAccepted)))
(assert (distinct selectedLabel (- 1)))
(check-sat)
(pop)
