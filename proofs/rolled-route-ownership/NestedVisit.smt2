; Descriptor head admission and bounded reset; not universal Rust refinement.
(set-logic QF_LIA)
(declare-const outerStart Int)
(declare-const innerStart Int)
(declare-const innerEnd Int)
(declare-const prefix Int)
(declare-const target Int)
(declare-const prefixLive Bool)
(declare-const prefixDone Bool)
(define-fun resetPrefix () Bool
  (ite (and (<= innerStart prefix) (< prefix innerEnd)) false prefixDone))
(define-fun resetTarget () Bool
  (ite (and (<= innerStart target) (< target innerEnd)) false prefixDone))
(push)
(assert (and (<= 0 outerStart) (<= outerStart prefix) (< prefix innerStart)
             (<= innerStart target) (< target innerEnd) prefixLive prefixDone))
(check-sat)
(assert (distinct resetPrefix prefixDone))
(check-sat)
(pop)
(declare-const fresh Bool)
(declare-const selected Int)
(declare-const proposed Int)
(push)
(assert (and (not fresh) (or fresh (= selected proposed))))
(check-sat)
(assert (distinct selected proposed))
(check-sat)
(pop)
(push)
(assert (and (<= 0 outerStart) (<= outerStart prefix) (< prefix target) prefixLive))
(check-sat)
; A head cannot have a live predecessor within its enclosing visit.
(assert (not (and (<= outerStart prefix) (< prefix target) prefixLive)))
(check-sat)
(pop)
(push)
(assert (and (<= 0 innerStart) (<= innerStart target) (< target innerEnd)))
(check-sat)
(assert resetTarget)
(check-sat)
(pop)
