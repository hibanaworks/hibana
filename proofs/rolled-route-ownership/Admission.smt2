; Source-linked admission/uniqueness model. This is not a Rust refinement proof.
(set-logic QF_LIA)
(declare-const done Bool)
(declare-const pos Int)
(declare-const head Int)
(declare-const reentry Bool)
(declare-const exact Bool)
(declare-const row Bool)
(declare-const dependency Bool)
(declare-const conflict Bool)
(declare-const laneHead Bool)
(declare-const offerEntry Bool)
(define-fun old () Bool (or (not done) reentry))
(define-fun admission () Bool (or (not (or done (< pos head))) reentry))
(define-fun eligible () Bool
  (and exact row dependency conflict laneHead admission offerEntry))
(declare-const otherEligible Bool)
(define-fun selected () Bool (and eligible (not otherEligible)))
(assert (and (>= pos 0) (>= head 0)))

; The materialized head bounds a fresh visit. A parked lane instead uses a
; later committed event on that lane; absence of a head is not completion.
(declare-const headKnown Bool)
(declare-const laterCommitted Bool)
(define-fun progressPassed () Bool (ite headKnown (< pos head) laterCommitted))
(echo "fresh head excludes outside-visit completion: premises SAT, violation UNSAT")
(push)
(assert (and headKnown (>= pos head)))
(check-sat)
(assert progressPassed)
(check-sat)
(pop)
(echo "parked lane needs later completion: premises SAT, violation UNSAT")
(push)
(assert (and (not headKnown) (not laterCommitted)))
(check-sat)
(assert progressPassed)
(check-sat)
(pop)
(echo "parked past suffix with commit evidence: SAT")
(push)
(assert (and (not headKnown) laterCommitted progressPassed))
(check-sat)
(pop)

(echo "old unselected suffix witness: SAT")
(push)
(assert (and (= pos 4) (= head 11) (not done) (not reentry) old (not admission)))
(check-sat)
(pop)
(echo "committed history survives a different preview: SAT")
(push)
(declare-const committedArm Int)
(declare-const previewArm Int)
(assert (and (= committedArm 1) (= previewArm 0) reentry admission))
(check-sat)
(pop)

(echo "past requires reentry: premises SAT, violation UNSAT")
(push)
(assert (and admission (< pos head)))
(check-sat)
(assert (not reentry))
(check-sat)
(pop)

(echo "no new admissions: premises SAT, violation UNSAT")
(push)
(assert admission)
(check-sat)
(assert (not old))
(check-sat)
(pop)

(echo "forward preserved: premises SAT, violation UNSAT")
(push)
(assert (>= pos head))
(check-sat)
(assert (distinct old admission))
(check-sat)
(pop)

(echo "completed guard preserved: premises SAT, violation UNSAT")
(push)
(assert done)
(check-sat)
(assert (distinct old admission))
(check-sat)
(pop)

(echo "elastic preserved: premises SAT, violation UNSAT")
(push)
(assert reentry)
(check-sat)
(assert (not admission))
(check-sat)
(pop)

(echo "selected requires every descriptor guard: premises SAT, violation UNSAT")
(push)
(assert selected)
(check-sat)
(assert (or (not exact) (not row) (not dependency) (not conflict)
  (not laneHead) (not admission) (not offerEntry)))
(check-sat)
(pop)

(echo "selection is unique: premises SAT, violation UNSAT")
(push)
(assert selected)
(check-sat)
(assert otherEligible)
(check-sat)
(pop)

(echo "unique eligible candidate is selected: premises SAT, violation UNSAT")
(push)
(assert (and eligible (not otherEligible)))
(check-sat)
(assert (not selected))
(check-sat)
(pop)

(echo "current Continue211 positive: SAT")
(push)
(assert (and (= pos 14) (= head 11) (not done) (not reentry)
  exact row dependency conflict laneHead offerEntry (not otherEligible) selected))
(check-sat)
(pop)

(echo "authorized elastic head positive: SAT")
(push)
(assert (and (= pos 0) (= head 11) done reentry
  exact row dependency conflict laneHead offerEntry (not otherEligible) selected))
(check-sat)
(pop)

(echo "ambiguity rejects: SAT")
(push)
(assert (and eligible otherEligible (not selected)))
(check-sat)
(pop)
