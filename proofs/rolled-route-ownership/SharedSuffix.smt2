; Committed completion and candidate head admission are separate views.
; Semantic abstraction of the repair, not universal Rust refinement.
(set-logic QF_LIA)
(declare-const old Bool)
(declare-const candidate Bool)
(declare-const completed Bool)
(define-fun selectionKnown () Bool
  (not (and completed (distinct old candidate))))
(define-fun headChoice () Bool (ite selectionKnown old candidate))
(push)
(assert completed)
(check-sat)
(assert (distinct headChoice candidate))
(check-sat)
(pop)
(push)
(assert (not completed))
(check-sat)
(assert (or (not selectionKnown) (distinct headChoice old)))
(check-sat)
(pop)
(declare-const start Int)
(declare-const finish Int)
(declare-const index Int)
(declare-const done Bool)
(define-fun within () Bool (and (<= start index) (< index finish)))
(define-fun resetDone () Bool (ite within false done))
(push)
(assert (and (<= 0 start) within))
(check-sat)
(assert resetDone)
(check-sat)
(pop)
(push)
(assert (and (<= 0 start) (< start finish) (not within)))
(check-sat)
(assert (distinct resetDone done))
(check-sat)
(pop)
; Positive witnesses for both directions and the old false-rejection case.
(push)
(assert (and completed (not old) candidate headChoice))
(check-sat)
(pop)
(push)
(assert (and completed old (not candidate) (not headChoice)))
(check-sat)
(pop)
(push)
(assert (and completed (not old) candidate (not old) headChoice))
(check-sat)
(pop)
; A parked suffix cannot reuse its previous visit's completed prefix.
(declare-const prior Int)
(declare-const priorLive Bool)
(define-fun livePrior () Bool (and (<= start prior) (< prior index) priorLive))
(define-fun atHead () Bool (not livePrior))
(push)
(assert (and completed (<= 0 start) (<= start prior) (< prior index) priorLive))
(check-sat)
(assert atHead)
(check-sat)
(pop)
(push)
(assert (and completed (<= 0 start) (= index start)))
(check-sat)
(assert (not atHead))
(check-sat)
(pop)
