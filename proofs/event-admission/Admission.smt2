(set-logic QF_UFBV)
(declare-const present Bool)
(declare-const lane_valid Bool)
(declare-const idx (_ BitVec 16))
(declare-const eff (_ BitVec 16))
(declare-const label (_ BitVec 8))
(declare-const origin (_ BitVec 1))
(declare-const scope (_ BitVec 16))
(declare-const arm (_ BitVec 8))
(declare-const lane (_ BitVec 8))
(declare-const requested_eff (_ BitVec 16))
(declare-const requested_label (_ BitVec 8))
(declare-const requested_origin (_ BitVec 1))
(declare-const requested_scope (_ BitVec 16))
(declare-const requested_arm (_ BitVec 8))
(declare-const requested_lane (_ BitVec 8))
(declare-const next (_ BitVec 16))
(declare-const dependency (_ BitVec 32))
(declare-const conflict (_ BitVec 16))
(declare-const progress (_ BitVec 16))
(declare-const lane_copy (_ BitVec 8))
(declare-const next_first (_ BitVec 16))
(declare-const next_checked (_ BitVec 16))
(declare-const dependency_copy (_ BitVec 32))
(declare-const conflict_copy (_ BitVec 16))
(declare-const progress_checked (_ BitVec 16))
(declare-const seed (_ BitVec 32))
(declare-const changed_seed (_ BitVec 32))

; Arbitrary live checks and their route-callback observations. They are NOT
; retained descriptor metadata or cached decisions. Short-circuit order matters.
(declare-fun dependency_ok ((_ BitVec 32) (_ BitVec 32)) Bool)
(declare-fun dependency_state ((_ BitVec 32) (_ BitVec 32)) (_ BitVec 32))
(declare-fun conflict_ok ((_ BitVec 32) (_ BitVec 16)) Bool)
(declare-fun conflict_state ((_ BitVec 32) (_ BitVec 16)) (_ BitVec 32))
(declare-fun reentry_ok ((_ BitVec 32) (_ BitVec 16) (_ BitVec 8)) Bool)
(declare-fun reentry_state ((_ BitVec 32) (_ BitVec 16) (_ BitVec 8)) (_ BitVec 32))
(declare-fun head_ok ((_ BitVec 32) (_ BitVec 16)) Bool)
(declare-fun head_state ((_ BitVec 32) (_ BitVec 16)) (_ BitVec 32))

(define-fun immutable () Bool
  (and (= lane_copy lane) (= next_first next) (= next_checked next)
    (= dependency_copy dependency) (= conflict_copy conflict)
    (= progress_checked progress)))
(define-fun other_key_matches () Bool
  (and (= requested_eff eff) (= requested_label label) (= requested_origin origin)
    (= requested_scope scope) (= requested_arm arm)))
(define-fun key_matches () Bool (and other_key_matches (= requested_lane lane)))
(define-fun old_static () Bool
  (and present lane_valid other_key_matches (= requested_lane lane_copy)
    (= next_first next_checked)))
(define-fun new_static () Bool (and present lane_valid key_matches))

; A failure carries no certificate. The observer state remains the value at
; the same rejection point. Success carries index, progress, next and lane.
(define-fun rejected ((s (_ BitVec 32))) (_ BitVec 89)
  (concat (_ bv0 57) s))
(define-fun accepted ((n (_ BitVec 16)) (s (_ BitVec 32))) (_ BitVec 89)
  (concat #b1 (concat idx (concat progress (concat n (concat lane s))))))

(define-fun old_observation ((s (_ BitVec 32))) (_ BitVec 89)
  (let ((ds (dependency_state s dependency_copy)))
  (let ((cs (conflict_state ds conflict_copy)))
  (let ((rs (reentry_state cs idx requested_lane)))
  (let ((hs (head_state rs conflict_copy)))
    (ite (not old_static) (rejected s)
      (ite (not (dependency_ok s dependency_copy)) (rejected ds)
        (ite (not (conflict_ok ds conflict_copy)) (rejected cs)
          (ite (not (= progress_checked progress)) (rejected cs)
            (ite (not (reentry_ok cs idx requested_lane)) (rejected rs)
              (ite (not (head_ok rs conflict_copy)) (rejected hs)
                (accepted next_first hs))))))))))))
(define-fun new_observation ((s (_ BitVec 32))) (_ BitVec 89)
  (let ((ds (dependency_state s dependency)))
  (let ((cs (conflict_state ds conflict)))
  (let ((rs (reentry_state cs idx requested_lane)))
  (let ((hs (head_state rs conflict)))
    (ite (not new_static) (rejected s)
      (ite (not (dependency_ok s dependency)) (rejected ds)
        (ite (not (conflict_ok ds conflict)) (rejected cs)
          (ite (not (reentry_ok cs idx requested_lane)) (rejected rs)
            (ite (not (head_ok rs conflict)) (rejected hs)
              (accepted next hs)))))))))))
(define-fun admitted ((v (_ BitVec 89))) Bool (= ((_ extract 88 88) v) #b1))

(push)
(assert immutable)
(assert (admitted (new_observation seed)))
; Non-vacuous accepted operation under the immutable-reader premises.
(check-sat)
(pop)

(push)
(assert immutable)
(assert (distinct (old_observation seed) (new_observation seed)))
; Result, certificate AND callback observations coincide for all live checks.
(check-sat)
(pop)

(push)
(assert (not key_matches))
(assert (admitted (new_observation seed)))
; Every identity field remains rejecting; no prefix or partial-key acceptance.
(check-sat)
(pop)

(push)
(assert (not present))
(assert (distinct (new_observation seed) (rejected seed)))
; A missing descriptor row cannot call any live check or modify observation.
(check-sat)
(pop)

(push)
(assert (not lane_valid))
(assert (admitted (new_observation seed)))
; Physical/logical lane correspondence is still required.
(check-sat)
(pop)

(push)
(assert new_static)
(assert (not (dependency_ok seed dependency)))
(assert (admitted (new_observation seed)))
; Reusing static facts never skips the current dependency decision.
(check-sat)
(pop)

(push)
(assert new_static)
(assert (not (admitted (new_observation seed))))
(assert (admitted (new_observation changed_seed)))
; Same static descriptor can become eligible after actual live progress.
(check-sat)
(pop)

(push)
(assert new_static)
(assert (= lane_copy lane))
(assert (= dependency_copy dependency))
(assert (= conflict_copy conflict))
(assert (= progress_checked progress))
(assert (admitted (new_observation seed)))
(assert (distinct next_first next_checked))
(assert (not (admitted (old_observation seed))))
; Without immutability, removing repeated checks is UNSOUND: real SAT witness.
(check-sat)
(pop)
