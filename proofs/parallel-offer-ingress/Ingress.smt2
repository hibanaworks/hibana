; Unbounded opaque frame/visit values; guards of the collecting continuation.
; No model of transport fairness, arbitrary Rust, or final branch admission.
(set-logic QF_LIA)
(declare-const owned Bool)
(declare-const heldFrame Int)
(declare-const selected Int)
(declare-const selectedFrame Int)
(declare-const active Int)
(declare-const activeFrame Int)
(assert (and (<= 0 selected) (<= selected 2) (<= 0 active) (<= active 2)))
; selected: 0 waiting, 1 evidence, 2 error. active: 0 absent, 1 frame, 2 error.
(define-fun collection () Int (ite owned 1 selected))
(define-fun inspected () Bool (= collection 0))
; next: 0 waiting, 1 selecting, 2 resolving, 3 terminal error.
(define-fun next () Int
  (ite (= collection 1) 2
    (ite (= collection 2) 3 (ite (= active 1) 1 (ite (= active 2) 3 0)))))
(define-fun carried () Int
  (ite owned heldFrame (ite (= selected 1) selectedFrame activeFrame)))
; SAT witnesses ensure independent-frame and existing-frame premises are reachable.
(push)
(assert (and (not owned) (= selected 0) (= active 1)))
(assert (and (= collection 0) (= next 1)))
(check-sat)
(pop)
(push)
(assert (and owned (= active 1) (distinct heldFrame activeFrame)))
(assert (and (= next 2) (= carried heldFrame)))
(check-sat)
(pop)
; Eight counterexample obligations.
(push)
(assert (and owned inspected))
(check-sat)
(pop)
(push)
(assert (and (= next 1) (or owned (distinct selected 0) (distinct active 1))))
(check-sat)
(pop)
(push)
(assert (and (= next 1) (distinct carried activeFrame)))
(check-sat)
(pop)
(push)
(assert (and owned (or (distinct next 2) (distinct carried heldFrame))))
(check-sat)
(pop)
(push)
(assert (and (not owned) (= selected 1) inspected))
(check-sat)
(pop)
(push)
(assert (and (not owned) (= selected 2) (distinct next 3)))
(check-sat)
(pop)
(push)
(assert (and (not owned) (= selected 0) (= active 0) (distinct next 0)))
(check-sat)
(pop)
(push)
(assert (and (not owned) (= selected 0) (= active 2) (distinct next 3)))
(check-sat)
(pop)
