; Conditional prerequisites do not define whether an event exists.
; This abstracts the repaired cursor rule, not arbitrary Rust execution.
(set-logic QF_LIA)
(declare-const dependencyActive Bool)
(declare-const prerequisiteComplete Bool)
(declare-const sameLane Bool)
(declare-const later Bool)
(declare-const outsideChild Bool)
(declare-const done Bool)
(declare-const ownConflict Bool)
(define-fun prerequisite () Bool (or (not dependencyActive) prerequisiteComplete))
(define-fun continuation () Bool (and sameLane later outsideChild done ownConflict))
(push)
(assert (and (not dependencyActive) (not prerequisiteComplete) sameLane later outsideChild done ownConflict))
(check-sat)
(assert (not (and prerequisite continuation)))
(check-sat)
(pop)
(push)
(assert (and dependencyActive (not prerequisiteComplete)))
(check-sat)
(assert prerequisite)
(check-sat)
(pop)
(push)
(assert continuation)
(check-sat)
(assert (or (not sameLane) (not later) (not outsideChild) (not done) (not ownConflict)))
(check-sat)
(pop)
