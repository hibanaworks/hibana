(set-logic QF_AUFLIA)
(declare-const explicit Int)
(declare-const committed Int)
(declare-const candidate Int)
(assert (and (<= (- 1) explicit) (<= explicit 1)))
(assert (and (<= (- 1) committed) (<= committed 1)))
(assert (and (<= (- 1) candidate) (<= candidate 1)))
(define-fun prospective () Int
  (ite (= explicit (- 1)) candidate explicit))
(declare-const identity Bool)
(declare-const conflict Bool)
(declare-const fresh Bool)
(declare-const head Bool)
(declare-const dependency Bool)
(define-fun guards () Bool (and identity conflict fresh))
; Admission: invalid=0, waiting=1, enabled=2.
(define-fun admission () Int (ite guards (ite dependency (ite head 2 0) 1) 0))
(declare-const branch Bool)
; Action: reject=0, retain=1, preview=2.
(define-fun action () Int (ite (= admission 0) 0
  (ite (= admission 1) 1 (ite branch 2 1))))
(declare-sort Frame 0)
(declare-const frame Frame)
(declare-const lane Int)
(declare-const other Int)
(declare-const queues (Array Int (Array Int Frame)))
(declare-const active (Array Int Bool))
(define-fun restored () (Array Int (Array Int Frame))
  (store queues lane (store (select queues lane) (- 1) frame)))
(define-fun remaining () (Array Int Bool) (store active lane false))
(push)
(assert (and (= explicit (- 1)) (= committed (- 1))))
(assert (distinct prospective candidate))
(check-sat)
(pop)
; Enabled admission still requires every check, including the lane head.
(push)
(assert (= admission 2))
(assert (not (and guards head dependency)))
(check-sat)
(pop)
(push)
(assert (and guards (not dependency) (not head)))
(assert (distinct admission 1))
(check-sat)
(pop)
(declare-const enabled_count Int)
(declare-const pending_count Int)
(assert (and (>= enabled_count 0) (>= pending_count 0)))
(define-fun selected_action () Int
  (ite (= enabled_count 1) 2
    (ite (and (= enabled_count 0) (> pending_count 0)) 1 0)))
(push)
(assert (and (= enabled_count 0) (> pending_count 0)))
(assert (distinct selected_action 1))
(check-sat)
(pop)
(push)
(assert (= enabled_count 1))
(assert (distinct selected_action 2))
(check-sat)
(pop)
(push)
(assert (> enabled_count 1))
(assert (distinct selected_action 0))
(check-sat)
(pop)
(push)
(assert (>= explicit 0))
(assert (distinct prospective explicit))
(check-sat)
(pop)
(push)
(assert (and (= explicit (- 1)) (= candidate (- 1))))
(assert (distinct prospective (- 1)))
(check-sat)
(pop)
(push)
(assert (= admission 1))
(assert (or (not guards) dependency))
(check-sat)
(pop)
(push)
(assert (= admission 1))
(assert (distinct action 1))
(check-sat)
(pop)
(push)
(assert (= admission 0))
(assert (distinct action 0))
(check-sat)
(pop)
(push)
(assert (= action 2))
(assert (distinct admission 2))
(check-sat)
(pop)
(push)
(assert (distinct (select (select restored lane) (- 1)) frame))
(check-sat)
(pop)
(push)
(assert (distinct other lane))
(assert (distinct (select restored other) (select queues other)))
(check-sat)
(pop)
(push)
(assert (select remaining lane))
(check-sat)
(pop)
(push)
(assert (distinct other lane))
(assert (select active other))
(assert (not (select remaining other)))
(check-sat)
(pop)
(push)
(assert (not identity))
(assert (= action 1))
(check-sat)
(pop)
; Previously an unseen parent disabled its conditional predecessor row.
(push)
(declare-const required Int)
(declare-const predecessor_done Bool)
(assert (and (= explicit (- 1)) (= committed (- 1))))
(assert (>= candidate 0))
(assert (= required candidate))
(assert (not predecessor_done))
(assert (or (distinct explicit required) predecessor_done))
(assert (not (or (distinct prospective required) predecessor_done)))
(check-sat)
(pop)
; Previously the lane-head guard rejected an otherwise valid future frame.
(push)
(assert (and guards (not dependency) (not head)))
(assert (= admission 1))
(assert (= (ite (and guards head) (ite dependency 2 1) 0) 0))
(check-sat)
(pop)
; Next-visit retention changes no admission rule. It only retains an exact
; first incoming entry while this lane's previously received arm is unfinished.
(declare-const reentrant Bool)
(declare-const first_on_lane Bool)
(declare-const different_arm Bool)
(declare-const current_was_receive Bool)
(declare-const current_entry_done Bool)
(declare-const current_arm_done Bool)
(define-fun future_wait () Bool
  (and reentrant first_on_lane different_arm current_was_receive
       current_entry_done (not current_arm_done)))
(define-fun updated_action () Int
  (ite (and (= admission 0) future_wait) 1 action))
(push)
(assert future_wait)
(assert (not (and reentrant first_on_lane different_arm current_was_receive
                  current_entry_done (not current_arm_done))))
(check-sat)
(pop)
(push)
(assert (= admission 0))
(assert (not current_entry_done))
(assert (distinct updated_action 0))
(check-sat)
(pop)
(push)
(assert (= admission 0))
(assert current_arm_done)
(assert (distinct updated_action 0))
(check-sat)
(pop)
(push)
(assert (= admission 0))
(assert (= updated_action 2))
(check-sat)
(pop)
(push)
(assert (= updated_action 2))
(assert (distinct admission 2))
(check-sat)
(pop)
(push)
(assert (= admission 0))
(assert future_wait)
(assert (distinct updated_action 1))
(check-sat)
(pop)
; Historical selection rejected this legal early entry before its nested step.
(push)
(assert (= admission 0))
(assert future_wait)
(assert (= action 0))
(assert (= updated_action 1))
(check-sat)
(pop)
