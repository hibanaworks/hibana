(set-logic QF_UFBV)
(declare-fun initialOwner ((_ BitVec 24)) (_ BitVec 8))
(declare-fun known ((_ BitVec 24)) Bool)
(declare-fun knownValue ((_ BitVec 24)) (_ BitVec 8))
(declare-const leftKey (_ BitVec 24))
(declare-const rightKey (_ BitVec 24))
(declare-const leftActor (_ BitVec 8))
(declare-const rightActor (_ BitVec 8))
(declare-const leftInitial Bool)
(declare-const rightInitial Bool)
(declare-const choice Bool)
(assert (=> (known leftKey) (= (knownValue leftKey) (initialOwner leftKey))))
(assert (=> (known rightKey) (= (knownValue rightKey) (initialOwner rightKey))))
(define-fun leftMeaning () (_ BitVec 8)
  (ite leftInitial (initialOwner leftKey) leftActor))
(define-fun rightMeaning () (_ BitVec 8)
  (ite rightInitial (initialOwner rightKey) rightActor))
(define-fun leftNormalizedInitial () Bool (and leftInitial (not (known leftKey))))
(define-fun rightNormalizedInitial () Bool (and rightInitial (not (known rightKey))))
(define-fun leftNormalizedActor () (_ BitVec 8)
  (ite (and leftInitial (known leftKey)) (knownValue leftKey) leftActor))
(define-fun rightNormalizedActor () (_ BitVec 8)
  (ite (and rightInitial (known rightKey)) (knownValue rightKey) rightActor))
(define-fun leftNormalizedMeaning () (_ BitVec 8)
  (ite leftNormalizedInitial (initialOwner leftKey) leftNormalizedActor))
(define-fun rightNormalizedMeaning () (_ BitVec 8)
  (ite rightNormalizedInitial (initialOwner rightKey) rightNormalizedActor))
(define-fun sameNormalized () Bool
  (and (= leftNormalizedInitial rightNormalizedInitial)
       (ite leftNormalizedInitial (= leftKey rightKey)
            (= leftNormalizedActor rightNormalizedActor))))
(push)
(assert (or (distinct leftMeaning leftNormalizedMeaning)
            (distinct rightMeaning rightNormalizedMeaning)))
; EXPECT: unsat
(check-sat)
(pop)
(push)
(assert sameNormalized)
(assert (distinct (ite choice leftMeaning rightMeaning) leftNormalizedMeaning))
; EXPECT: unsat
(check-sat)
(pop)
(push)
(assert leftInitial)
(assert rightInitial)
(assert (not (known leftKey)))
(assert (not (known rightKey)))
(assert (= ((_ extract 7 0) leftKey) ((_ extract 7 0) rightKey)))
(assert (distinct leftKey rightKey))
(assert (distinct leftMeaning rightMeaning))
(assert (not sameNormalized))
; EXPECT: sat
(check-sat)
(pop)

; Closed source traces must contain a return after a departure. Transfer
; receivers are snapshots, independent of later carrier-role movement.
(declare-const initial (_ BitVec 8))
(declare-const departed (_ BitVec 8))
(declare-const r0 (_ BitVec 8))
(declare-const r1 (_ BitVec 8))
(declare-const r2 (_ BitVec 8))
(declare-const sent0 Bool)
(declare-const sent1 Bool)
(declare-const sent2 Bool)
(define-fun final-holder () (_ BitVec 8)
  (ite sent2 r2 (ite sent1 r1 (ite sent0 r0 departed))))
(define-fun has-return () Bool
  (or (and sent0 (= r0 initial)) (and sent1 (= r1 initial))
      (and sent2 (= r2 initial))))
(push)
(assert (distinct departed initial))
(assert (= final-holder initial))
(assert (not has-return))
; EXPECT: unsat
(check-sat)
(pop)

; Sensitivity: without the checked final owner a return need not exist.
(push)
(assert (distinct departed initial))
(assert (distinct final-holder initial))
(assert (not has-return))
; EXPECT: sat
(check-sat)
(pop)
