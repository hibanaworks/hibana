(set-logic QF_BV)
(declare-const firstRole (_ BitVec 8))
(declare-const secondRole (_ BitVec 8))
(declare-const targetRole (_ BitVec 8))
(declare-const firstComponent (_ BitVec 16))
(declare-const secondComponent (_ BitVec 16))
(declare-const targetComponent (_ BitVec 16))
(declare-const firstOwned Bool)
(declare-const secondOwned Bool)
(define-fun firstBit () (_ BitVec 256)
  (bvshl (_ bv1 256) ((_ zero_extend 248) firstRole)))
(define-fun secondBit () (_ BitVec 256)
  (bvshl (_ bv1 256) ((_ zero_extend 248) secondRole)))
(define-fun targetBit () (_ BitVec 256)
  (bvshl (_ bv1 256) ((_ zero_extend 248) targetRole)))
(define-fun summary () (_ BitVec 256)
  (bvor (ite firstOwned firstBit (_ bv0 256))
        (ite secondOwned secondBit (_ bv0 256))))
(define-fun indexed () Bool (distinct (bvand summary targetBit) (_ bv0 256)))
(define-fun exact () Bool
  (or (and firstOwned (= firstRole targetRole) (= firstComponent targetComponent))
      (and secondOwned (= secondRole targetRole) (= secondComponent targetComponent))))
(push)
(assert (distinct indexed (or (and firstOwned (= firstRole targetRole))
                             (and secondOwned (= secondRole targetRole)))))
; EXPECT: unsat
(check-sat)
(pop)
(push)
(assert (distinct (and indexed exact) exact))
; EXPECT: unsat
(check-sat)
(pop)
(push)
(assert firstOwned)
(assert (not secondOwned))
(assert (= firstRole targetRole))
(assert (distinct firstComponent targetComponent))
(assert indexed)
(assert (not exact))
; EXPECT: sat
(check-sat)
(pop)
