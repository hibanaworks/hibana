; The sealed constructor checks both directions of the immutable inverse map.
; Query 1: a returned slot cannot name another source route.
(reset)
(set-logic ALL)
(declare-const routes (Array Int Int))
(declare-const index (Array Int Int))
(declare-const query Int)
(declare-const extent Int)
(declare-const count Int)
(assert (and (<= 0 query) (< query extent) (<= extent 8192)))
(assert (not (= (select index query) 65535)))
(assert (and (<= 0 (select index query)) (< (select index query) count)
             (= (select routes (select index query)) query)))
(assert (or (>= (select index query) count)
            (not (= (select routes (select index query)) query))))
; EXPECT: unsat
(check-sat)
; Query 2: duplicate source keys cannot certify different slots.
(reset)
(set-logic ALL)
(declare-const routes (Array Int Int))
(declare-const index (Array Int Int))
(declare-const left Int)
(declare-const right Int)
(assert (= (select index (select routes left)) left))
(assert (= (select index (select routes right)) right))
(assert (= (select routes left) (select routes right)))
(assert (not (= left right)))
; EXPECT: unsat
(check-sat)
; Query 3: both bytes of a present entry stay inside the checked image span.
(reset)
(set-logic ALL)
(declare-const start Int)
(declare-const extent Int)
(declare-const query Int)
(declare-const blob_len Int)
(assert (and (<= 0 start) (<= 0 query) (< query extent) (<= extent 8192)
             (<= start 65535)
             (<= (+ start (* 2 extent)) blob_len) (<= blob_len 81919)))
(assert (or (< (+ start (* 2 query)) start)
            (>= (+ start (* 2 query) 1) blob_len)))
; EXPECT: unsat
(check-sat)
; Query 4: a permuted sparse map is permitted.
(reset)
(set-logic ALL)
(declare-const routes (Array Int Int))
(declare-const index (Array Int Int))
(assert (= (select routes 0) 7))
(assert (= (select routes 1) 0))
(assert (= (select index 7) 0))
(assert (= (select index 0) 1))
; EXPECT: sat
(check-sat)
; Query 5: omitting the reverse check admits an unsolicited key.
(reset)
(set-logic ALL)
(declare-const routes (Array Int Int))
(declare-const index (Array Int Int))
(assert (= (select routes 0) 7))
(assert (= (select index 7) 0))
(assert (= (select index 2) 0))
(assert (not (= (select routes (select index 2)) 2)))
; EXPECT: sat
(check-sat)
; Query 6: omitting the forward check can lose a declared route.
(reset)
(set-logic ALL)
(declare-const routes (Array Int Int))
(declare-const index (Array Int Int))
(assert (= (select routes 0) 7))
(assert (= (select index 7) 65535))
; EXPECT: sat
(check-sat)
; Query 7: a wrong-kind or absent raw scope cannot address this table.
(reset)
(set-logic ALL)
(declare-const query Int)
(declare-const extent Int)
(assert (and (<= 0 extent) (<= extent 8192) (>= query 8192)))
(assert (< query extent))
; EXPECT: unsat
(check-sat)
