; Local work scheduling does not create ingress or change a live route choice.
; Abstract obligations, not a universal Rust refinement.
(set-logic ALL)
(declare-const live Bool)
(declare-const selected Bool)
(declare-const candidate Bool)
(declare-const eligible Bool)
(declare-const controller Bool)
(declare-const dynamic Bool)
(declare-const ready Bool)
(declare-const progress Bool)
(declare-const readyArm Bool)
(declare-const committed Bool)
(define-fun armAllowed () Bool (or (not live) (= selected candidate)))
(define-fun runnable () Bool (and eligible controller dynamic ready armAllowed))
(define-fun retainedChoice () Bool
  (or live (and controller (not dynamic) committed)))
(push)
(assert (and eligible controller dynamic ready (not live) (not progress) (not readyArm)))
(check-sat)
(assert (not runnable))
(check-sat)
(pop)
(push)
(assert runnable)
(check-sat)
(assert (not eligible))
(check-sat)
(pop)
(push)
(assert (and runnable live))
(check-sat)
(assert (distinct selected candidate))
(check-sat)
(pop)
(push)
(assert (and runnable (not progress) (not readyArm)))
(check-sat)
(pop)
; Completing a send-selected arm cannot erase its committed controller choice.
(push)
(assert (and committed controller (not dynamic) (not live)))
(check-sat)
(assert (not retainedChoice))
(check-sat)
(pop)
; A completed observer does not prevent scheduling a pending resolver sibling.
(push)
(assert (and committed (not controller) (not live)))
(check-sat)
(assert retainedChoice)
(check-sat)
(pop)
; A completed resolver choice cannot authorize another visit on its own.
(push)
(assert (and committed controller dynamic (not live)))
(check-sat)
(assert retainedChoice)
(check-sat)
(pop)
; Completed prefix and enclosing-head retries are alternatives to the borrow.
(declare-const insideReady Bool)
(declare-const outsideReady Bool)
(declare-const prefixComplete Bool)
(declare-const rollEnd Int)
(declare-const rollStart Int)
(declare-const continuationStart Int)
(declare-const sequential Bool)
(define-fun completedPrefix () Bool
  (and prefixComplete sequential
    (or (<= rollEnd continuationStart)
        (and (<= rollStart continuationStart) (< continuationStart rollEnd)))))
(declare-const reentryComplete Bool)
(declare-const afterReentry Bool)
(declare-const otherSource Int)
(declare-const differentArms Bool)
(define-fun otherArmAlternative () Bool
  (and prefixComplete differentArms
    (<= rollStart otherSource) (< otherSource rollEnd)
    (<= rollStart continuationStart) (< continuationStart rollEnd)))
(define-fun borrowAllowed () Bool
  (and insideReady (or (not outsideReady) completedPrefix
    (and reentryComplete sequential afterReentry) otherArmAlternative)))
; Prefixes and parallel siblings do not occupy different choice arms.
(push)
(assert (not differentArms))
(push)
(assert (and insideReady outsideReady prefixComplete sequential
  (<= rollEnd continuationStart)))
(check-sat)
(assert (not borrowAllowed))
(check-sat)
(pop)

; Completion belongs to the committed visit; coverage belongs to the selected
; entry. They need not select the same arm.
(declare-const oldActive (_ BitVec 6))
(declare-const newActive (_ BitVec 6))
(declare-const completedRows (_ BitVec 6))
(declare-const borrowedRows (_ BitVec 6))
(define-fun oldComplete () Bool (= (bvand oldActive completedRows) oldActive))
(define-fun newCovered () Bool (= (bvand newActive borrowedRows) newActive))
(define-fun repeatBorrow () Bool (and oldComplete newCovered))
(push)
(assert (= oldActive #b000111))
(assert (= completedRows #b000111))
(assert (= newActive #b111000))
(assert (= borrowedRows #b111000))
(check-sat)
(assert (not repeatBorrow))
(check-sat)
(pop)
(push)
(assert repeatBorrow)
(assert (distinct (bvand oldActive borrowedRows) oldActive))
(check-sat)
(pop)
(push)
(assert repeatBorrow)
(assert (distinct (bvand newActive borrowedRows) newActive))
(check-sat)
(pop)
(push)
(assert repeatBorrow)
(assert (not oldComplete))
(check-sat)
(pop)

; A borrow's reset epoch remains usable until that parent resets. A child
; reset does not advance it. Refusing overflow prevents an old borrow alias.
(declare-const borrowEpoch Int)
(declare-const currentEpoch Int)
(define-fun maxEpoch () Int 18446744073709551615)
(push)
(assert (and (<= 0 currentEpoch) (< currentEpoch maxEpoch)
  (= borrowEpoch currentEpoch)))
(check-sat)
(assert (= borrowEpoch (+ currentEpoch 1)))
(check-sat)
(pop)
(push)
(assert (and (<= 0 currentEpoch) (< currentEpoch maxEpoch)
  (= borrowEpoch currentEpoch)))
(check-sat)
(assert (> (+ currentEpoch 1) maxEpoch))
(check-sat)
(pop)
(push)
(assert (and borrowAllowed outsideReady (not prefixComplete) (not reentryComplete)))
(check-sat)
(pop)
(push)
(assert (and borrowAllowed outsideReady (not sequential)))
(check-sat)
(pop)
(push)
(assert (and borrowAllowed outsideReady (> rollEnd continuationStart)
  (> rollStart continuationStart) (not afterReentry)))
(check-sat)
(pop)
(push)
(assert (and borrowAllowed (not insideReady)))
(check-sat)
(pop)
(push)
(assert (and insideReady outsideReady prefixComplete sequential
  (<= rollStart continuationStart) (< continuationStart rollEnd)))
(check-sat)
(assert (not borrowAllowed))
(check-sat)
(pop)

; A completed group's sequential suffix is an alternative to repeating it.
; An independent sibling cannot be omitted under that rule.
(push)
(assert (and insideReady outsideReady (not prefixComplete) reentryComplete sequential afterReentry))
(check-sat)
(assert (not borrowAllowed))
(check-sat)
(pop)
(push)
(assert (and borrowAllowed outsideReady (not completedPrefix) (not afterReentry)))
(check-sat)
(pop)
(pop)

; A completed outer visit can either restart with another choice or continue
; the current arm's inner repeat. A different arm is not a parallel sibling.
(push)
(assert (and insideReady outsideReady prefixComplete differentArms
  (<= rollStart otherSource) (< otherSource rollEnd)
  (<= rollStart continuationStart) (< continuationStart rollEnd)
  (not sequential) (not reentryComplete)))
(check-sat)
(assert (not borrowAllowed))
(check-sat)
(pop)
(push)
(assert (and borrowAllowed outsideReady differentArms (not prefixComplete)
  (not reentryComplete)))
(check-sat)
(pop)
(push)
(assert (and borrowAllowed outsideReady prefixComplete differentArms
  (>= otherSource rollEnd) (not sequential) (not reentryComplete)))
(check-sat)
(pop)
(push)
(assert (and borrowAllowed outsideReady prefixComplete differentArms
  (< continuationStart rollStart) (not sequential) (not reentryComplete)))
(check-sat)
(pop)
