; Local work scheduling does not create ingress or change a live route choice.
; Abstract obligations, not a universal Rust refinement.
(set-logic QF_LIA)
(declare-const live Bool)
(declare-const selected Bool)
(declare-const candidate Bool)
(declare-const eligible Bool)
(declare-const controller Bool)
(declare-const dynamic Bool)
(declare-const ready Bool)
(declare-const progress Bool)
(declare-const readyArm Bool)
(declare-const committed Bool)
(define-fun armAllowed () Bool (or (not live) (= selected candidate)))
(define-fun runnable () Bool (and eligible controller dynamic ready armAllowed))
(define-fun retainedChoice () Bool
  (or live (and controller (not dynamic) committed)))
(push)
(assert (and eligible controller dynamic ready (not live) (not progress) (not readyArm)))
(check-sat)
(assert (not runnable))
(check-sat)
(pop)
(push)
(assert runnable)
(check-sat)
(assert (not eligible))
(check-sat)
(pop)
(push)
(assert (and runnable live))
(check-sat)
(assert (distinct selected candidate))
(check-sat)
(pop)
(push)
(assert (and runnable (not progress) (not readyArm)))
(check-sat)
(pop)
; Completing a send-selected arm cannot erase its committed controller choice.
(push)
(assert (and committed controller (not dynamic) (not live)))
(check-sat)
(assert (not retainedChoice))
(check-sat)
(pop)
; A completed observer does not prevent scheduling a pending resolver sibling.
(push)
(assert (and committed (not controller) (not live)))
(check-sat)
(assert retainedChoice)
(check-sat)
(pop)
; A completed resolver choice cannot authorize another visit on its own.
(push)
(assert (and committed controller dynamic (not live)))
(check-sat)
(assert retainedChoice)
(check-sat)
(pop)
