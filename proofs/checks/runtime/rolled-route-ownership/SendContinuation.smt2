; Source-linked decision boundary abstraction, not universal Rust refinement.
; A containing arm is not a controller entry. No event eligibility conjunct is
; removed: the later step and commit both retain the existing full guard.
(set-logic QF_LIA)
(declare-const candidate Int)
(declare-const entry0 Int)
(declare-const entry1 Int)
(declare-const rediscovered Int)
(declare-const routeStart Bool)
(declare-const unlabeled Bool)
(declare-const dynamic Bool)
; The candidate has the requested outgoing contract in the selected arm.
(declare-const confirmed Bool)
(declare-const member Bool)
(declare-const enabled Bool)
(define-fun boundary () Bool (or routeStart unlabeled dynamic (= candidate entry0) (= candidate entry1)))
(define-fun located () Int (ite confirmed candidate (ite boundary rediscovered candidate)))
(push)
(assert (and (not routeStart) (not unlabeled) (not dynamic) (distinct candidate entry0 entry1) enabled member))
(check-sat)
(assert (not (= located candidate)))
(check-sat)
(pop)
(push)
(assert (or routeStart unlabeled dynamic (= candidate entry0) (= candidate entry1)))
(check-sat)
(assert (not boundary))
(check-sat)
(pop)

(push)
; A dynamic resolver still runs, but confirmation preserves event identity.
(assert (and dynamic confirmed enabled member))
(check-sat)
(assert (not (= located candidate)))
(check-sat)
(pop)
(push)
; Sensitivity: always rediscovering at a dynamic scope can select an earlier
; occurrence despite a confirmed, enabled continuation.
(assert (and dynamic confirmed enabled member (distinct candidate rediscovered)))
(assert (not (= (ite boundary rediscovered candidate) candidate)))
(check-sat)
(pop)
(push)
; Historical witness: arm membership redirected an enabled continuation.
(assert (and (not routeStart) (not unlabeled) (distinct candidate entry0 entry1) enabled member (distinct candidate rediscovered)))
(assert (not (= (ite (or boundary member) rediscovered candidate) candidate)))
(check-sat)
(pop)
