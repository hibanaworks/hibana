; Model of the reentry guard in event_progress.rs, with the remaining admission
; and unique-offer guards as conjuncts. This is not a Rust refinement proof.
(set-logic QF_LIA)
(declare-const done Bool)
(declare-const completedRoll Bool)
(declare-const compatible Bool)
(declare-const explicit Bool)
(declare-const headAllowed Bool)
(declare-const reentryAllowed Bool)
(declare-const exact Bool)
(declare-const row Bool)
(declare-const dependency Bool)
(declare-const conflict Bool)
(declare-const laneBound Bool)
(declare-const offerEntry Bool)
(define-fun admission () Bool
  (ite explicit headAllowed (ite (or done completedRoll) reentryAllowed compatible)))
(define-fun eligible () Bool
  (and exact row dependency conflict laneBound admission offerEntry))
(declare-const otherEligible Bool)
(define-fun selected () Bool (and eligible (not otherEligible)))

(echo "unfinished current event admitted: premises SAT, violation UNSAT")
(push)
(assert (and (not done) (not completedRoll) compatible (not explicit)))
(check-sat)
(assert (not admission))
(check-sat)
(pop)

(echo "committed branch respected: premises SAT, violation UNSAT")
(push)
(assert (and (not done) (not completedRoll) (not compatible) (not explicit)))
(check-sat)
(assert admission)
(check-sat)
(pop)

(echo "completed event requires reentry: premises SAT, violation UNSAT")
(push)
(assert (and (not explicit) done admission))
(check-sat)
(assert (not reentryAllowed))
(check-sat)
(pop)

(echo "completed roll requires reentry: premises SAT, violation UNSAT")
(push)
(assert (and (not explicit) completedRoll admission))
(check-sat)
(assert (not reentryAllowed))
(check-sat)
(pop)

(echo "explicit reentry requires its head: premises SAT, violation UNSAT")
(push)
(assert (and explicit admission))
(check-sat)
(assert (not headAllowed))
(check-sat)
(pop)

(echo "automatic reentry preserves completed events: premises SAT, violation UNSAT")
(push)
(assert (and (not explicit) done reentryAllowed))
(check-sat)
(assert (not admission))
(check-sat)
(pop)

(echo "selected requires every descriptor guard: premises SAT, violation UNSAT")
(push)
(assert selected)
(check-sat)
(assert (or (not exact) (not row) (not dependency) (not conflict)
  (not laneBound) (not admission) (not offerEntry)))
(check-sat)
(pop)

(echo "selection is unique: premises SAT, violation UNSAT")
(push)
(assert selected)
(check-sat)
(assert otherEligible)
(check-sat)
(pop)

(echo "unique eligible candidate is selected: premises SAT, violation UNSAT")
(push)
(assert (and eligible (not otherEligible)))
(check-sat)
(assert (not selected))
(check-sat)
(pop)

; Lookup metadata can change without consuming a step. The corresponding
; production-cursor Kani checks also move the actual lane locator.
(declare-const pos Int)
(declare-const head Int)
(declare-const headKnown Bool)
(echo "unfinished receive beyond lookup head: SAT")
(push)
(assert (and (= pos 4) (= head 11) headKnown
  (not done) (not completedRoll) compatible (not explicit) (not reentryAllowed)
  exact row dependency conflict laneBound offerEntry (not otherEligible) selected))
(check-sat)
(pop)

(echo "parked unfinished receive: SAT")
(push)
(assert (and (not headKnown) (not done) (not completedRoll) compatible (not explicit)
  exact row dependency conflict laneBound offerEntry (not otherEligible) selected))
(check-sat)
(pop)

(echo "authorized fresh head replaces old choice: SAT")
(push)
(assert (and explicit headAllowed (not compatible) admission))
(check-sat)
(pop)

(echo "authorized elastic head positive: SAT")
(push)
(assert (and done (not explicit) reentryAllowed
  exact row dependency conflict laneBound offerEntry (not otherEligible) selected))
(check-sat)
(pop)

(echo "ambiguity rejects: SAT")
(push)
(assert (and eligible otherEligible (not selected)))
(check-sat)
(pop)
