; Actual binary controller-entry selection. It does not model arbitrary Rust.
(set-logic QF_LIA)
(declare-const left Int)
(declare-const right Int)
(declare-const later Int)
(declare-const leftMatches Bool)
(declare-const rightMatches Bool)
(declare-const interiorMatches Bool)
(define-fun selected () Int (ite leftMatches left (ite rightMatches right (- 1))))
(define-fun oldSelected () Int
  (ite leftMatches left (ite interiorMatches later (ite rightMatches right (- 1)))))
(push)
(assert (and (>= left 0) (>= right 0) (>= later 0) (distinct later left right)))
(check-sat)
(assert (= selected later))
(check-sat)
(pop)
(push)
(assert (and (>= right 0) (not leftMatches) rightMatches))
(check-sat)
(assert (distinct selected right))
(check-sat)
(pop)
(push)
; The old per-arm body scan could find a matching interior before visiting
; the other arm's actual entry. This premise has a concrete counterexample.
(assert (and (= left 0) (= later 4) (= right 6) (not leftMatches) interiorMatches rightMatches))
(assert (and (= oldSelected later) (= selected right) (distinct oldSelected selected)))
(check-sat)
(pop)
