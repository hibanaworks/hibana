(set-logic QF_UFBV)
(declare-const admit0 Bool)
(declare-const admit1 Bool)
(declare-const candidate0 Bool)
(declare-const candidate1 Bool)
(declare-const excluded0 Bool)
(declare-const excluded1 Bool)
(declare-const value0 (_ BitVec 16))
(declare-const value1 (_ BitVec 16))
; The high bit records presence, so every source position remains available.
(define-fun none () (_ BitVec 17) (_ bv0 17))
(define-fun some ((value (_ BitVec 16))) (_ BitVec 17) (concat #b1 value))
(define-fun old () (_ BitVec 17)
  (ite admit0 (ite candidate0 (some value0)
    (ite admit1 (ite candidate1 (some value1) none) none))
    (ite admit1 (ite candidate1 (some value1) none) none)))
(define-fun filtered () (_ BitVec 17)
  (ite (and candidate0 admit0) (some value0)
    (ite (and candidate1 admit1) (some value1) none)))
(define-fun excluded () (_ BitVec 17)
  (ite (and (not excluded0) candidate0 admit0) (some value0)
    (ite (and (not excluded1) candidate1 admit1) (some value1) none)))
(push)
(assert (and admit1 candidate1 (not admit0)))
(check-sat)
(pop)
(push)
(assert (not (= old filtered)))
(check-sat)
(pop)
(push)
(assert (and (=> excluded0 (not candidate0)) (=> excluded1 (not candidate1))))
(assert (not (= old excluded)))
(check-sat)
(pop)
; Dropping admission or suppressing a genuine candidate must be detectable.
(push)
(assert (not (= old (ite candidate0 (some value0) (ite candidate1 (some value1) none)))))
(check-sat)
(pop)
(push)
(assert (not (= old excluded)))
(check-sat)
(pop)
