(set-logic QF_BV)
(declare-const done (_ BitVec 32))
(declare-const low (_ BitVec 32))
(declare-const high (_ BitVec 32))
(declare-const bit (_ BitVec 32))
(declare-const live (_ BitVec 32))
(define-fun one () (_ BitVec 32) #x00000001)
(define-fun full () (_ BitVec 32) #xffffffff)
(define-fun mask () (_ BitVec 32)
  (bvand (bvshl full low)
    (ite (bvuge high #x00000020) full (bvsub (bvshl one high) one))))
(define-fun pending () (_ BitVec 32) (bvand (bvnot done) mask))
(push)
(assert (bvult low #x00000020))
(assert (bvule high #x00000020))
(assert (bvult bit #x00000020))
; Non-vacuous legal mask premises.
(check-sat)
; Exact membership for all 2^32 completion patterns and all legal word edges.
(assert (not (= (not (= (bvand (bvlshr pending bit) one) #x00000000))
  (and (= (bvand (bvlshr done bit) one) #x00000000)
       (bvule low bit) (bvult bit high)))))
(check-sat)
(pop)
(declare-const cut (_ BitVec 32))
(define-fun clippedPrefix ((end (_ BitVec 32))) (_ BitVec 32)
  (ite (bvuge end #x00000020) full (bvsub (bvshl one end) one)))
(define-fun skipped () (_ BitVec 32)
  (bvand (bvshl full low) (clippedPrefix cut)))
(define-fun remaining () (_ BitVec 32)
  (bvand (bvnot done) (bvand (bvshl full cut) (clippedPrefix high))))
(push)
(assert (bvule low cut))
(assert (bvule cut high))
(assert (bvule high #x00000020))
(assert (= (bvand live skipped) #x00000000))
; A rejected arm contains no live step, including unknown completion bits.
(check-sat)
; Both the pending blocker set and the nonempty participation domain survive.
(assert (not (and
  (= (bvand pending live) (bvand remaining live))
  (= (bvand live mask)
     (bvand live (bvand (bvshl full cut) (clippedPrefix high)))))))
(check-sat)
(pop)
(push)
(assert (bvule low cut))
(assert (bvult cut high))
(assert (bvule high #x00000020))
(assert (= done #x00000000))
(assert (= live (bvshl one cut)))
; Advancing one step beyond the excluded arm can erase a live successor.
(define-fun tooFar () (_ BitVec 32)
  (bvand (bvnot done) (bvand (bvshl full (bvadd cut one)) (clippedPrefix high))))
(assert (not (= (bvand pending live) (bvand tooFar live))))
(check-sat)
(pop)
(declare-const events (_ BitVec 32))
(declare-const rolls (_ BitVec 32))
(declare-const epochs (_ BitVec 32))
(define-fun wordCount ((bits (_ BitVec 32))) (_ BitVec 32)
  (bvudiv (bvadd bits #x0000001f) #x00000020))
(define-fun completionBits () (_ BitVec 32)
  (ite (= epochs #x00000000) (bvadd events rolls)
    (bvadd (bvmul (wordCount (bvadd events rolls)) #x00000020)
      (bvmul epochs #x00000040))))
(push)
(assert (bvule events #x0000ffff))
(assert (bvule rolls #x0000ffff))
(assert (bvule epochs rolls))
; Both bitmap-only and epoch-bearing layouts have valid compact instances.
(check-sat)
(assert (or
  (not (bvule (wordCount events) (wordCount completionBits)))
  (not (bvult completionBits #xffffffe0))))
(check-sat)
(pop)
(define-fun members () (_ BitVec 32) (bvand live mask))
(push)
(assert (bvule low #x00000020))
(assert (bvule high #x00000020))
; Arbitrary selected local events, including an absent/empty scope.
(check-sat)
; All selected events are done iff no selected pending event remains.
; Both formulations require a nonempty selected local domain.
(assert (not (= (and (not (= members #x00000000)) (= (bvand members done) members))
  (and (= (bvand pending live) #x00000000) (not (= members #x00000000))))))
(check-sat)
(pop)
(declare-const value (_ BitVec 32))
(push)
(assert (bvult bit #x00000020))
(assert (= (bvand value (bvsub (bvshl one bit) one)) #x00000000))
(assert (not (= (bvand value (bvshl one bit)) #x00000000)))
; A real, nonzero selected least bit exists.
(check-sat)
; Rust pending &= pending - 1 removes exactly that least bit.
(assert (not (= (bvand value (bvsub value one))
  (bvand value (bvnot (bvshl one bit))))))
(check-sat)
(pop)
(push)
; The iterator cannot loop on an unchanged nonzero word.
(assert (not (= value #x00000000)))
(assert (not (bvult (bvand value (bvsub value one)) value)))
(check-sat)
(pop)
(push)
; Clearing a committed bit on roll reentry restores that exact pending step.
(assert (bvult bit #x00000020))
(assert (bvule low bit))
(assert (bvult bit high))
(assert (bvule high #x00000020))
(define-fun cleared () (_ BitVec 32) (bvand done (bvnot (bvshl one bit))))
(assert (= (bvand (bvand (bvnot cleared) mask) (bvshl one bit)) #x00000000))
(check-sat)
(pop)
