(set-logic QF_BV)
(declare-const retained Bool)
(declare-const held (_ BitVec 8))
(declare-const requested (_ BitVec 8))
(define-fun pollable () Bool (not (and retained (= held requested))))
(push)
(assert (and retained (= held requested)))
(check-sat)
(assert pollable)
(check-sat)
(pop)
(push)
(assert (distinct held requested))
(check-sat)
(assert (not pollable))
(check-sat)
(pop)
(push)
(assert (not retained))
(check-sat)
(assert (not pollable))
(check-sat)
(pop)
(declare-const excluded Bool)
(declare-const pending Bool)
(define-fun outOfOrder () Bool (and excluded (not pending)))
(push)
(assert (and excluded (not pending)))
(check-sat)
(assert (not outOfOrder))
(check-sat)
(pop)
(push)
(assert pending)
(check-sat)
(assert outOfOrder)
(check-sat)
(pop)
; The missing exclusion admits a second poll on an already borrowed Rx.
(push)
(assert (and retained (= held requested)))
(assert (distinct true pollable))
(check-sat)
(pop)
