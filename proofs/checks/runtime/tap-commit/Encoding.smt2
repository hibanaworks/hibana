(set-logic QF_BV)
(declare-const actor (_ BitVec 8))
(declare-const direction (_ BitVec 8))
(declare-const view (_ BitVec 8))
(declare-const lane (_ BitVec 8))
(declare-const source (_ BitVec 16))
(define-fun context ((v (_ BitVec 8)) (l (_ BitVec 8)) (s (_ BitVec 16))) (_ BitVec 32)
  (bvor (bvshl ((_ zero_extend 24) v) #x00000018)
    (bvor (bvshl ((_ zero_extend 24) l) #x00000010) ((_ zero_extend 16) s))))
(define-fun causal ((a (_ BitVec 8)) (d (_ BitVec 8))) (_ BitVec 16)
  (bvor (bvshl ((_ zero_extend 8) a) #x0008) ((_ zero_extend 8) d)))
(push)
(check-sat)
(assert (not (and
  (= ((_ extract 31 24) (context view lane source)) view)
  (= ((_ extract 23 16) (context view lane source)) lane)
  (= ((_ extract 15 0) (context view lane source)) source)
  (= ((_ extract 15 8) (causal actor direction)) actor)
  (= ((_ extract 7 0) (causal actor direction)) direction))))
(check-sat)
(pop)
(declare-const other_view (_ BitVec 8))
(declare-const other_lane (_ BitVec 8))
(declare-const other_source (_ BitVec 16))
(push)
(assert (= (context view lane source) (context other_view other_lane other_source)))
(check-sat)
(assert (or (distinct view other_view) (distinct lane other_lane)
  (distinct source other_source)))
(check-sat)
(pop)
; Keeping only eight source bits aliases distinct legal wire identities.
(push)
(assert (= view other_view))
(assert (= lane other_lane))
(assert (distinct source other_source))
(assert (= (context view lane (bvand source #x00ff))
  (context other_view other_lane (bvand other_source #x00ff))))
(check-sat)
(pop)
