; Unbounded scalar checks of the source-linked offer selection guards.
; Descriptor decoding and the complete Rust executor are outside this model.
(set-logic QF_LIA)

; Reuse existing branch knowledge only after receiving an actual frame, or for
; a non-receive operation. Event admission and exact frame matching remain
; independent requirements of offer publication.
(declare-const coherentDecision Bool)
(declare-const receivingOperation Bool)
(declare-const acquiredFrame Bool)
(define-fun reuseKnownDecision () Bool
  (and coherentDecision (or (not receivingOperation) acquiredFrame)))
(push)
(assert receivingOperation)
(assert (not acquiredFrame))
(assert reuseKnownDecision)
(check-sat)
(pop)
(push)
(assert (not coherentDecision))
(assert reuseKnownDecision)
(check-sat)
(pop)
(push)
(assert coherentDecision)
(assert (not receivingOperation))
(assert (not acquiredFrame))
(assert (not reuseKnownDecision))
(check-sat)
(pop)
(push)
(assert coherentDecision)
(assert receivingOperation)
(assert acquiredFrame)
(assert reuseKnownDecision)
(check-sat)
(pop)
; A committed outgoing choice needs no frame. Actual acquired frames are
; selected before this rank; other candidates preserve their base ordering.
(define-fun offerPriority ((base Int) (outgoing Bool) (unmade Bool)) Int
  (+ (ite outgoing 16 0) (* 2 base) (ite unmade 1 0)))
(declare-const basePriority Int)
(declare-const lowerPriority Int)
(declare-const higherPriority Int)
(declare-const lowerUnmade Bool)
(declare-const higherUnmade Bool)
(declare-const lowerOutgoing Bool)
(declare-const higherOutgoing Bool)
(push)
(assert (= basePriority 3))
(assert (< (offerPriority basePriority lowerOutgoing false) (offerPriority basePriority lowerOutgoing true)))
(check-sat)
(pop)
(push)
(assert (>= (offerPriority basePriority lowerOutgoing false) (offerPriority basePriority lowerOutgoing true)))
(check-sat)
(pop)
(push)
(assert (< lowerPriority higherPriority))
(assert (= lowerOutgoing higherOutgoing))
(assert (>= (offerPriority lowerPriority lowerOutgoing lowerUnmade)
            (offerPriority higherPriority higherOutgoing higherUnmade)))
(check-sat)
(pop)
(push)
(assert (and (<= 1 basePriority) (<= basePriority 4)))
(assert (> (offerPriority basePriority lowerOutgoing lowerUnmade) 25))
(check-sat)
(pop)
(push)
(assert (and (<= 1 lowerPriority) (<= lowerPriority 4)
             (<= 1 higherPriority) (<= higherPriority 4)))
(assert (< (offerPriority lowerPriority false lowerUnmade)
           (offerPriority higherPriority true higherUnmade)))
(check-sat)
(assert (>= (offerPriority lowerPriority false lowerUnmade)
            (offerPriority higherPriority true higherUnmade)))
(check-sat)
(pop)
(push)
; Sensitivity: the earlier rank can tie an unframed repeat receive with an
; outgoing continuation, so source-index order can select the waiting receive.
(assert (= lowerUnmade higherUnmade))
(assert (= (+ (* 2 basePriority) (ite lowerUnmade 1 0))
           (+ (* 2 basePriority) (ite higherUnmade 1 0))))
(check-sat)
(pop)
; Resolver entry admission preserves both operation and lane. Merely finding
; an eligible scope entry does not admit a different observed descendant.
(declare-const entryEvent Int)
(declare-const entryLane Int)
(declare-const descendantEvent Int)
(declare-const descendantLane Int)
(declare-const entryAllowed Bool)
(declare-const descendantAllowed Bool)
(push)
(assert entryAllowed)
(assert (not descendantAllowed))
(assert (distinct entryEvent descendantEvent))
(assert (distinct entryLane descendantLane))
(check-sat)
(pop)
(declare-const pickedEvent Int)
(declare-const pickedLane Int)
(declare-const pickedAllowed Bool)
(assert (= pickedEvent entryEvent))
(assert (= pickedLane entryLane))
(assert (= pickedAllowed entryAllowed))
(push)
(assert entryAllowed)
(assert (not pickedAllowed))
(check-sat)
(pop)
(push)
(assert (or (distinct pickedEvent entryEvent) (distinct pickedLane entryLane)))
(check-sat)
(pop)
; Event membership uses the actual past choice, not the candidate actor union.
(declare-const actor Int)
(declare-const selectedActor Int)
(declare-const choiceKnown Bool)
(define-fun excludedActor () Bool (and choiceKnown (distinct actor selectedActor)))
(push)
(assert (not choiceKnown))
(assert excludedActor)
(check-sat)
(pop)
(push)
(assert (= actor selectedActor))
(assert excludedActor)
(check-sat)
(pop)
(push)
(assert (and choiceKnown (distinct actor selectedActor)))
(assert (not excludedActor))
(check-sat)
(pop)
; A view may await another view's prerequisite, without admitting a commit.
(declare-const ownPending Bool)
(declare-const anotherPending Bool)
(declare-const ownsPayload Bool)
(declare-const payloadPending Bool)
(define-fun waitsOther () Bool
  (and anotherPending (not ownPending) (not (and ownsPayload payloadPending))))
(define-fun commitReady () Bool (and (not ownPending) (not anotherPending)))
(push)
(assert ownPending)
(assert waitsOther)
(check-sat)
(pop)
(push)
(assert waitsOther)
(assert commitReady)
(check-sat)
(pop)
(push)
(assert (and (not ownPending) (not anotherPending)))
(assert waitsOther)
(check-sat)
(pop)
(push)
(assert (and (not ownPending) anotherPending))
(assert (not commitReady))
(check-sat)
(pop)
(push)
(assert (and ownsPayload payloadPending))
(assert waitsOther)
(check-sat)
(pop)
(push)
(assert (and ownsPayload (not payloadPending) (not ownPending) anotherPending))
(assert waitsOther)
(check-sat)
(pop)
(declare-const outer Int)
(declare-const inner Int)
(declare-const outerPending Bool)
(declare-const innerPending Bool)
(define-fun priority () Int (ite outerPending outer (ite innerPending inner (- 1))))
(define-fun oldPriority () Int (ite innerPending inner (ite outerPending outer (- 1))))
(push)
(assert (and outerPending innerPending (distinct outer inner)))
(assert (distinct oldPriority outer))
(check-sat)
(pop)

; Actor-wide view residence cannot grant route control. Each head is one
; projected operation, not an inferred current-holder table.
(declare-const controller Int)
(declare-const view Int)
(declare-const leftRole Int)
(declare-const rightRole Int)
(declare-const leftPresent Bool)
(declare-const rightPresent Bool)
(declare-const leftOutbound Bool)
(declare-const rightOutbound Bool)
(declare-const residentController Bool)
(define-fun projectedController () Bool
  (or (and leftPresent leftOutbound (= leftRole controller))
      (and rightPresent rightOutbound (= rightRole controller))))
(define-fun viewController () Bool (and projectedController (= view controller)))
(push)
(assert residentController)
(assert (and leftPresent rightPresent (not leftOutbound) (not rightOutbound)))
(assert (distinct residentController projectedController))
(check-sat)
(pop)
(push)
(assert (and (not leftPresent) (not rightPresent)))
(assert projectedController)
(check-sat)
(pop)
(push)
(assert (and (not leftOutbound) (not rightOutbound)))
(assert projectedController)
(check-sat)
(pop)
(push)
(assert (and leftPresent leftOutbound (= leftRole controller)))
(assert (not projectedController))
(check-sat)
(pop)
(push)
(assert (distinct view controller))
(assert viewController)
(check-sat)
(pop)
(push)
(assert (not projectedController))
(assert viewController)
(check-sat)
(pop)
(push)
(assert outerPending)
(assert (distinct priority outer))
(check-sat)
(pop)
(push)
(assert (and (not outerPending) innerPending))
(assert (distinct priority inner))
(check-sat)
(pop)
(declare-const different Bool)
(declare-const atEntry Bool)
(declare-const member Bool)
(declare-const current Int)
(declare-const canonical Int)
(define-fun aligned () Int (ite (and different (not atEntry)) canonical current))
(push)
(assert (and different (not atEntry) member (distinct current canonical)))
(assert (distinct (ite (and different (not member)) canonical current) canonical))
(check-sat)
(pop)
(push)
(assert (and different (not atEntry)))
(assert (distinct aligned canonical))
(check-sat)
(pop)
(push)
(assert atEntry)
(assert (distinct aligned current))
(check-sat)
(pop)
(declare-const complete Bool)
(declare-const contains Bool)
(declare-const node Int)
(declare-const enclosing Int)
(define-fun envelope () Int (ite (and complete contains) enclosing node))
(push)
(assert (and complete contains))
(assert (distinct envelope enclosing))
(check-sat)
(pop)
(push)
(assert (not complete))
(assert (distinct envelope node))
(check-sat)
(pop)
(declare-const parentRight Bool)
(declare-const childRight Bool)
(declare-const parentAccepted Bool)
(declare-const childAccepted Bool)
(define-fun selectedLabel () Int (ite parentAccepted (ite parentRight (ite childAccepted (ite childRight 3 2) (- 1)) 1) (- 1)))
(push)
(assert (and parentAccepted childAccepted parentRight childRight))
(assert (distinct selectedLabel 3))
(check-sat)
(pop)
(push)
(assert (not parentAccepted))
(assert (distinct selectedLabel (- 1)))
(check-sat)
(pop)
(push)
(assert (and parentAccepted parentRight (not childAccepted)))
(assert (distinct selectedLabel (- 1)))
(check-sat)
(pop)
; A direct send can enter a parallel branch away from its canonical event.
; Its parent resolver remains mandatory at either position.
(declare-const sendAtEntry Bool)
(declare-const resolverPresent Bool)
(declare-const resolverMatches Bool)
(define-fun checksResolver () Bool (or sendAtEntry resolverPresent))
(define-fun allowedSend () Bool
  (and (or (not resolverPresent) checksResolver)
       (or (not resolverPresent) resolverMatches)))
(push)
(assert resolverPresent)
(assert (not sendAtEntry))
(assert (not checksResolver))
(check-sat)
(pop)
(push)
(assert resolverPresent)
(assert (not resolverMatches))
(assert allowedSend)
(check-sat)
(pop)
; Unresolved children do not become resolver-audit rows merely because their
; resolved ancestor is fresh.
(declare-const freshRow Bool)
(define-fun publishResolverAudit () Bool (and freshRow resolverPresent))
(push)
(assert freshRow)
(assert (not resolverPresent))
(assert publishResolverAudit)
(check-sat)
(pop)
; The previous canonical-entry-only rule admits a wrong parallel sibling.
(push)
(assert (not sendAtEntry))
(assert resolverPresent)
(assert (not resolverMatches))
(assert (ite sendAtEntry resolverMatches true))
(check-sat)
(pop)
; A completed inner visit resets only choices contained in its source range.
(declare-const bodyStart Int)
(declare-const bodyEnd Int)
(declare-const parentStart Int)
(declare-const parentEnd Int)
(declare-const retainedParent Bool)
(declare-const freshParent Bool)
(define-fun parentInsideReset () Bool
  (and (<= bodyStart parentStart) (<= parentEnd bodyEnd)))
(define-fun resumedParent () Bool
  (ite parentInsideReset freshParent retainedParent))
(push)
(assert (<= parentStart bodyStart))
(assert (<= bodyEnd parentEnd))
(assert (or (< parentStart bodyStart) (< bodyEnd parentEnd)))
(assert (distinct resumedParent retainedParent))
(check-sat)
(pop)
(push)
(assert (not parentInsideReset))
(assert (distinct resumedParent retainedParent))
(check-sat)
(pop)
(push)
(assert parentInsideReset)
(assert (distinct resumedParent freshParent))
(check-sat)
(pop)
; Using only parent completion can select the other branch during a child visit.
(push)
(assert (not parentInsideReset))
(assert (distinct freshParent retainedParent))
(assert (distinct freshParent resumedParent))
(check-sat)
(pop)
