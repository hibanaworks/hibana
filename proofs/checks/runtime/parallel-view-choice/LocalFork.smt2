(set-logic QF_LIA)
(declare-const left Bool)
(declare-const right Bool)
(declare-const frontier Bool)
(declare-const width Int)
(declare-const other-width Int)
(define-fun eligible ((n Int)) Bool
  (and frontier (or left right) (or (<= n 1) (and left right))))
(push)
(assert (eligible width))
(assert (not frontier))
; EXPECT: unsat
(check-sat)
(pop)
(push)
(assert (distinct (eligible 1) (and frontier (or left right))))
; EXPECT: unsat
(check-sat)
(pop)
(push)
(assert (> width 1))
(assert (> other-width 1))
(assert (distinct (eligible width) (eligible other-width)))
; EXPECT: unsat
(check-sat)
(pop)
(push)
(assert (> width 1))
(assert (or (not left) (not right)))
(assert (eligible width))
; EXPECT: unsat
(check-sat)
(pop)
(push)
(assert frontier)
(assert left)
(assert (not right))
(assert (eligible 1))
(assert (not (eligible 2)))
; EXPECT: sat
(check-sat)
(pop)
