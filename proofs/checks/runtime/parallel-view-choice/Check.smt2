(set-logic QF_LIA)
(declare-const first Int)
(declare-const split Int)
(declare-const boundary Int)
(declare-const limit Int)
(declare-const start Int)
(declare-const stop Int)
(assert (and (<= 0 first) (< first split) (< split boundary) (<= boundary limit)
             (<= 0 start) (<= 0 stop)))
(define-fun arm () Bool (or (and (<= first start) (<= stop split))
                           (and (<= split start) (<= stop boundary))))
(define-fun contains () Bool (and (<= start first) (<= boundary stop)))
(define-fun visible () Bool (and (< start stop) (<= stop limit) (or arm contains)))
(push)
(assert (and (< start stop) (<= stop limit) arm (not visible)))
(check-sat)
(pop)
(push)
(assert (and (< start stop) (<= stop limit) contains (not visible)))
(check-sat)
(pop)
(push)
(assert (and visible (or (<= stop first) (<= boundary start))))
(check-sat)
(pop)
(push)
(assert (and (= first 1) (= split 3) (= boundary 5) (= limit 8)
             (= start 0) (= stop 6) visible (not arm)))
(check-sat)
(pop)
(declare-const owns Bool)
(declare-const operations_done Bool)
(declare-const transfer_done Bool)
(define-fun complete () Bool (and operations_done (or (not owns) transfer_done)))
(push)
(assert (and complete (not operations_done)))
(check-sat)
(pop)
(push)
(assert (and (not owns) operations_done (not complete)))
(check-sat)
(pop)
(push)
(assert (and owns (not transfer_done) complete))
(check-sat)
(pop)
(push)
(assert (and operations_done (not transfer_done) (not owns) complete))
(check-sat)
(pop)
; The predicates below classify already established source predecessors.
(declare-const own_prefix Bool)
(declare-const payload_prefix Bool)
(define-fun borrow_wait () Bool (not own_prefix))
(define-fun send_wait () Bool (and (not own_prefix) (not payload_prefix)))
(push)
(assert (not (= send_wait (not (or own_prefix payload_prefix)))))
(check-sat)
(pop)
(push)
(assert (and own_prefix borrow_wait))
(check-sat)
(pop)
(push)
(assert (and payload_prefix send_wait))
(check-sat)
(pop)
(push)
(assert (and send_wait (not borrow_wait)))
(check-sat)
(pop)
(push)
(assert (and (not own_prefix) payload_prefix borrow_wait (not send_wait)))
(check-sat)
(pop)
