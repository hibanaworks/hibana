(set-logic QF_AUFLIA)
(declare-sort Frame 0)
(declare-const frame Frame)
(declare-const lane Int)
(declare-const other Int)
(declare-const queues (Array Int (Array Int Frame)))
(declare-const active (Array Int Bool))
(declare-const position Int)
(declare-const selected Int)
(declare-const post_position Int)
(declare-const post_selected Int)
(define-fun parked () (Array Int Bool) (store active lane false))
(define-fun restored () (Array Int (Array Int Frame))
  (store queues lane (store (select queues lane) (- 1) frame)))
(declare-const kind Int)
; missing=0, ambiguous=1, ordinary=2, unique branch=3.
(define-fun action () Int (ite (= kind 3) 2 (ite (= kind 2) 1 0)))
(push)
(assert (= kind 2))
(assert (= action 2))
(check-sat)
(pop)
(push)
(assert (= action 2))
(assert (distinct kind 3))
(check-sat)
(pop)
(push)
(assert (or (= kind 0) (= kind 1)))
(assert (distinct action 0))
(check-sat)
(pop)
(push)
(assert (= post_position position))
(assert (= post_selected selected))
(assert (or (distinct post_position position) (distinct post_selected selected)))
(check-sat)
(pop)
(push)
(assert (distinct (select (select restored lane) (- 1)) frame))
(check-sat)
(pop)
(push)
(assert (distinct other lane))
(assert (distinct (select restored other) (select queues other)))
(check-sat)
(pop)
(push)
(assert (select parked lane))
(check-sat)
(pop)
(push)
(assert (distinct other lane))
(assert (select active other))
(assert (not (select parked other)))
(check-sat)
(pop)
(push)
(declare-const cached_suffix_enabled Bool)
(assert (not cached_suffix_enabled))
(assert (= kind 3))
(assert (= action 2))
(check-sat)
(pop)
