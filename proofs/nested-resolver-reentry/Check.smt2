(set-logic QF_UF)
(declare-const selected Bool)
(declare-const completed Bool)
(declare-const own_entry Bool)
(declare-const inherited Bool)
(declare-const prior_arm Bool)
(declare-const callback_arm Bool)
(define-fun fresh () Bool (or inherited (not selected) (and completed own_entry)))
(define-fun old_fresh () Bool (or (not selected) completed))
(push)
(assert (and selected (not own_entry) (not inherited) fresh))
(check-sat)
(pop)
(push)
(assert (and (not selected) (not fresh)))
(check-sat)
(pop)
(push)
(assert (and completed own_entry (not fresh)))
(check-sat)
(pop)
(push)
(assert (and inherited (not fresh)))
(check-sat)
(pop)
(push)
(assert (and selected (not own_entry) (not inherited)))
(assert (distinct (ite fresh callback_arm prior_arm) prior_arm))
(check-sat)
(pop)
(push)
(assert (and selected completed (not own_entry) (not inherited) old_fresh (not fresh)))
(check-sat)
(pop)
