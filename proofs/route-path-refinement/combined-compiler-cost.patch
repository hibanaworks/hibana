+fn panic_message(error: std::boxed::Box<dyn core::any::Any + Send>) -> std::string::String {
+    if let Some(message) = error.downcast_ref::<&str>() {
+        (*message).into()
+    } else {
+        error.downcast_ref::<std::string::String>().unwrap().clone()
+    }
+}
